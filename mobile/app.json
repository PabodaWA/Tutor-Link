{
  "expo": {
    "name": "Tutor Link",
    "slug": "tutor-link",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tutorlink.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Tutor Link uses your camera for online tutoring meetings.",
        "NSMicrophoneUsageDescription": "Tutor Link uses your microphone for online tutoring meetings.",
        "UIViewControllerBasedStatusBarAppearance": false,
        "UIBackgroundModes": [
          "audio",
          "voip",
          "fetch"
        ]
      }
    },
    "android": {
      "package": "com.tutorlink.app",
      "permissions": [
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "BLUETOOTH",
        "CAMERA",
        "INTERNET",
        "MODIFY_AUDIO_SETTINGS",
        "POST_NOTIFICATIONS",
        "RECORD_AUDIO",
        "WAKE_LOCK",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "FOREGROUND_SERVICE_MEDIA_PROJECTION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#655CF6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "expo-document-picker",
      "expo-dev-client",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf463290-e0b5-4638-ba9c-d1e97b569c82"
      }
    },
    "owner": "lasiru71"
  }
}
